{
  "expo": {
    "name": "Bike Brevard Map",
    "slug": "brevard-bike-map",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon-light.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.pushpop.brevardbikemap",
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.pushpop.brevardbikemap",
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "3fecc21b-af13-4633-8059-fcc141ef7db4"
      }
    },
    "owner": "sarahbuildsapps",
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bike Brevard Map shows where you are on the trail map, only when you tap the location button. Your location stays on your phone.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EC",
          "image": "./assets/splash.png",
          "imageWidth": 380,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/android-splash.png",
            "imageWidth": 288
          }
        }
      ]
    ]
  }
}
