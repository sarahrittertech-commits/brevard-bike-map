{
  "cli": {
    "version": ">= 24.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "simulator": {
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "production": {
      "autoIncrement": true
    },
    "kids-preview": {
      "extends": "preview",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "kids" }
    },
    "kids-simulator": {
      "extends": "simulator",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "kids" }
    },
    "kids-production": {
      "extends": "production",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "kids" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6816144426"
      }
    }
  }
}
